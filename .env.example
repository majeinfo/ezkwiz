SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Needed if the app is served over HTTPS through a reverse proxy (nginx,
# Caddy, Traefik...) that forwards `X-Forwarded-Proto: https` -- otherwise
# login/forms will fail with "CSRF verification failed: Origin checking
# failed", since Django can't tell the original request was HTTPS.
# CSRF_TRUSTED_ORIGINS must list the exact public URL(s), scheme included.
BEHIND_HTTPS_PROXY=False
CSRF_TRUSTED_ORIGINS=https://your-domain.example

DB_NAME=quizz
DB_USER=quizz
DB_PASSWORD=quizz
DB_HOST=127.0.0.1
DB_PORT=3306

REDIS_URL=redis://127.0.0.1:6379/0

# Only used by docker-compose.yml (the full-stack file), to control which
# local address/port the ezkwiz container's port is published on. Defaults to
# 0.0.0.0:8000 (all interfaces) if unset. Set BIND_HOST=127.0.0.1 to keep it
# off the public network, e.g. behind a reverse proxy on the same host.
BIND_HOST=0.0.0.0
BIND_PORT=8000
